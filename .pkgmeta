# Packaging config for the BigWigs packager (used by .github/workflows/release.yml).
# The zip contains a single "EarnedSelfFound" folder - the name WoW and existing saved
# data expect. Do not change package-as.
package-as: EarnedSelfFound

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - tests
  - scripts
  - media
  - node_modules
  - package.json
  - package-lock.json
  - README.md
